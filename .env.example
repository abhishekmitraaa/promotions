# ==============================================================================
# WhatsApp Hub - Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# DATABASE_URL: Transaction pooler URL (port 6543) for Next.js application runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct connection (port 5432) for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Public Service URL (Used in links and webhook payload references)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API Configuration
# Get these credentials from your Meta Developer Console -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
# Meta Graph API version
META_GRAPH_API_VERSION="v22.0"

# Permanent System User Access Token with 'whatsapp_business_messaging' permission
META_ACCESS_TOKEN=""

# WhatsApp Phone Number ID (From API Setup tab)
META_PHONE_NUMBER_ID=""

# WhatsApp Business Account ID (WABA ID)
META_WABA_ID=""

# Meta App Secret (From App Settings -> Basic; used to verify X-Hub-Signature-256)
META_APP_SECRET=""

# Webhook Verification Token (Custom secret string configured in Meta Webhook settings)
META_WEBHOOK_VERIFY_TOKEN=""

# ------------------------------------------------------------------------------
# Security & Administrative Protection
# ------------------------------------------------------------------------------
# HMAC-SHA256 Pepper string used to hash API keys in the database.
# Must be at least 32 random characters in production. Placeholders are rejected.
API_KEY_PEPPER="change_this_to_a_random_32_character_secret_in_production"

# Session signing secret for dashboard authentication cookies (HMAC-SHA256).
# Must be at least 32 cryptographically random characters in production.
AUTH_SESSION_SECRET="change_this_to_a_random_32_character_secret_in_production"

# Optional secret for background worker queue processing (x-worker-secret header)
INTERNAL_WORKER_SECRET="change_this_to_a_random_worker_secret_in_production"

# ------------------------------------------------------------------------------
# OTP (One-Time Password) Service Configuration
# ------------------------------------------------------------------------------
OTP_CODE_LENGTH="6"
OTP_EXPIRY_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
# Approved WhatsApp Message Template name for sending authentication codes
OTP_TEMPLATE_NAME="auth_otp_code"
OTP_TEMPLATE_LANGUAGE="en_US"

# ------------------------------------------------------------------------------
# Logging & Outgoing Webhook Dispatcher
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
OUTBOUND_WEBHOOK_TIMEOUT_MS="10000"
OUTBOUND_WEBHOOK_MAX_RETRIES="5"

# ------------------------------------------------------------------------------
# Development Simulation Overrides
# Set to 'true' in development to simulate sending messages when Meta credentials
# are unconfigured. Automatically forced to 'false' in production mode.
# ------------------------------------------------------------------------------
DEV_ALLOW_UNCONFIGURED_META="true"
