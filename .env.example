# Local Database URL
DATABASE_URL="file:./dev.db"

# Public URL of the WhatsApp service application
APP_URL="http://localhost:3000"

# Meta WhatsApp Cloud API Configuration
# Meta Graph API version (e.g., v22.0)
META_GRAPH_API_VERSION="v22.0"
# Meta System User or Permanent Access Token with whatsapp_business_messaging permission
META_ACCESS_TOKEN=""
# Phone Number ID from WhatsApp Meta Developer Console
META_PHONE_NUMBER_ID=""
# WhatsApp Business Account (WABA) ID
META_WABA_ID=""
# Meta App Secret (used for verifying X-Hub-Signature-256 on incoming webhooks)
META_APP_SECRET=""
# Webhook Verification Token (custom secret string used during GET webhook verification challenge)
META_WEBHOOK_VERIFY_TOKEN=""

# Security Pepper used when hashing API Keys (Set a strong secret key string in production)
API_KEY_PEPPER="change_this_to_a_random_32_character_secret_in_production"

# OTP Verification Configuration
OTP_CODE_LENGTH="6"
OTP_EXPIRY_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_TEMPLATE_NAME="auth_otp_code"
OTP_TEMPLATE_LANGUAGE="en_US"

# Logging and Webhook Dispatcher
LOG_LEVEL="info"
OUTBOUND_WEBHOOK_TIMEOUT_MS="10000"
OUTBOUND_WEBHOOK_MAX_RETRIES="5"

# Development helper flag: allow local dev dashboard & health endpoints even without Meta credentials
DEV_ALLOW_UNCONFIGURED_META="true"
