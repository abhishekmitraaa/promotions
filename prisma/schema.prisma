generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  INTERACTIVE
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}


enum UserRole {
  ADMIN
  VIEWER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash  String
  role         UserRole      @default(VIEWER)
  active       Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]

  @@index([role])
  @@index([active])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Message {
  id                 String           @id @default(uuid())
  clientId           String
  providerMessageId  String?          @unique
  direction          MessageDirection
  type               MessageType      @default(TEXT)
  status             MessageStatus    @default(QUEUED)
  from               String
  to                 String
  body               String?
  templateName       String?
  templateLanguage   String?
  templateParameters String?
  mediaId            String?
  mediaUrl           String?
  errorCode          String?
  errorMessage       String?
  metadata           String?
  idempotencyKey     String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, idempotencyKey])
  @@index([clientId])
  @@index([status])
  @@index([from])
  @@index([to])
  @@index([providerMessageId])
  @@index([direction])
  @@index([createdAt])
}

model MessageEvent {
  id                String           @id @default(uuid())
  clientId          String?
  providerEventId   String?          @unique
  providerMessageId String?
  eventType         String
  payload           String
  processingStatus  ProcessingStatus @default(PENDING)
  errorMessage      String?
  receivedAt        DateTime         @default(now())
  processedAt       DateTime?
  createdAt         DateTime         @default(now())
  deliveries        WebhookDelivery[]

  client ApiClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([providerEventId])
  @@index([providerMessageId])
  @@index([eventType])
}

model ApiClient {
  id          String            @id @default(uuid())
  name        String
  description String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  keys        ApiKey[]
  messages    Message[]
  events      MessageEvent[]
  webhooks    WebhookEndpoint[]
  deliveries  WebhookDelivery[]
  otps        OtpVerification[]
}

model ApiKey {
  id         String    @id @default(uuid())
  clientId   String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([keyPrefix])
  @@index([clientId])
}

model WebhookEndpoint {
  id               String            @id @default(uuid())
  clientId         String
  name             String
  url              String
  encryptedSecret  String
  active           Boolean           @default(true)
  subscribedEvents String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deliveries       WebhookDelivery[]

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model WebhookDelivery {
  id             String         @id @default(uuid())
  clientId       String?
  endpointId     String
  eventId        String?
  messageEventId String?
  eventType      String
  payload        String
  status         DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  lockedAt       DateTime?
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  client       ApiClient?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messageEvent MessageEvent?   @relation(fields: [messageEventId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([endpointId])
  @@index([status])
  @@index([createdAt])
  @@index([status, nextAttemptAt])
  @@index([messageEventId])
}

model OtpVerification {
  id          String    @id @default(uuid())
  clientId    String
  destination String
  purpose     String
  codeHash    String
  status      OtpStatus @default(PENDING)
  expiresAt   DateTime
  attempts    Int       @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([destination])
  @@index([purpose])
  @@index([status])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
